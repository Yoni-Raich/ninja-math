    "narrator": {
      "voice": "Achird",
      "style": "in a clear, warm, friendly voice for a six year old child, steady medium pace, neutral calm intonation",
      "model": "gemini-3.1-flash-tts-preview"
    },
    "hero": {
      "voice": "Fenrir",
      "style": "as a brave, energetic young ninja warrior, loud and powerful, full of fighting spirit",
      "model": "gemini-3.8-flash-lite-tts"
    },
    "announcer": {
      "voice": "Charon",
      "style": "in a deep, dramatic, epic movie-trailer announcer voice, slow and powerful",
      "model": "gemini-2.5-flash-preview-tts"
    }
  },
